<?xml version="1.0"?>
<ruleset name="Luberius TailwindCSS Coding Standard">
    <description>PSR-12 coding standard for Luberius TailwindCSS package</description>

    <!-- Include the PSR-12 coding standard -->
    <rule ref="PSR12"/>

    <!-- Show progress and use colors -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>

    <!-- Exclude vendor directory -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>

    <!-- Additional rules -->

    <!-- Ensure there is no trailing whitespace -->
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace">
        <properties>
            <property name="ignoreBlankLines" value="false"/>
        </properties>
    </rule>

    <!-- Ensure array indentation is correct -->
    <rule ref="Generic.Arrays.ArrayIndent"/>

    <!-- Disallow long array syntax -->
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Force array declaration whitespace -->
    <rule ref="Squiz.Arrays.ArrayDeclaration">
        <!-- Disable this specific sniff as it conflicts with PSR-12 -->
        <exclude name="Squiz.Arrays.ArrayDeclaration.MultiLineNotAllowed"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.SingleLineNotAllowed"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.KeyNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.ValueNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.CloseBraceNotAligned"/>
        <exclude name="Squiz.Arrays.ArrayDeclaration.DoubleArrowNotAligned"/>
    </rule>

    <!-- Line length limit (soft limit 120, hard limit 150) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="150"/>
        </properties>
    </rule>

    <!-- Forbid comments starting with # -->
    <rule ref="PEAR.Commenting.InlineComment"/>

    <!-- Disallow empty statements -->
    <rule ref="Generic.CodeAnalysis.EmptyStatement"/>

    <!-- Disallow final methods in final classes -->
    <rule ref="Generic.CodeAnalysis.UnnecessaryFinalModifier"/>

    <!-- Disallow unused function parameters -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>

    <!-- Disallow useless overriding methods -->
    <rule ref="Generic.CodeAnalysis.UselessOverridingMethod"/>
</ruleset>
